NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Alternativa para projetos antigos: NEXT_PUBLIC_SUPABASE_ANON_KEY
# Usada nos links de confirmação e recuperação. Sem barra final.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Cobrança: variáveis exclusivamente do servidor. Vazio mantém o checkout indisponível.
BILLING_PROVIDER=
# Para conectar Stripe: BILLING_PROVIDER=stripe. Use chaves de teste na homologação.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Preço recorrente mensal de 2990 centavos em BRL. Não use ID de produto.
STRIPE_PRICE_ID=
# Chave secreta/service_role do Supabase: nunca adicionar NEXT_PUBLIC_ a esta variável.
SUPABASE_SERVICE_ROLE_KEY=
